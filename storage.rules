rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Ringtone audio files are publicly readable (the catalog is public);
    // uploads require an authenticated user (see the upload feature roadmap).
    match /ringtones/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
